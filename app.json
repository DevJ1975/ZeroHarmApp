{
  "expo": {
    "name": "Zero Harm",
    "slug": "zero-harm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zeroharm",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.trainovate.zeroharm",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5C400",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ai.trainovate.zeroharm"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F5C400",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#13233F"
          },
          "ios": {
            "image": "./assets/images/splash-logo.png",
            "imageWidth": 300,
            "resizeMode": "contain",
            "backgroundColor": "#F5C400",
            "dark": {
              "image": "./assets/images/splash-logo-dark.png",
              "backgroundColor": "#13233F"
            }
          }
        }
      ],
      [
        "onesignal-expo-plugin",
        {
          "mode": "development"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Zero Harm uses the camera when you take a group photo of your crew for the toolbox talk sign-in sheet.",
          "photosPermission": "Zero Harm lets you choose a crew photo from your library for the toolbox talk sign-in sheet.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Zero Harm uses your approximate location to show local weather, heat risk and weather alerts for your site.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      "expo-build-properties",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#F5C400"
  }
}
