# Set these as Railway variables on the web service (and the cron service). Never commit real values.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=${{Postgres.DATABASE_URL}}
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
GHL_PRIVATE_TOKEN=
GHL_LOCATION_ID=hQfWlcg3R4QsKoSZBWAy
INGEST_KEY=
# Content console key: a long random value, at least 32 characters (e.g. `openssl rand -hex 32`). Put the same value in console/.env.local. Blank or shorter = console off.
CONSOLE_KEY=
