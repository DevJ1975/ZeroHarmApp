# Copy this file to .env.local (git-ignored) and fill in both values.

# The Zero Harm web service on Railway, without a trailing slash. Must be https:// (the key rides along),
# except http://127.0.0.1:8000 or http://localhost:8000 for a backend running on this Mac.
# Example: https://zero-harm-api.up.railway.app
CONSOLE_API_URL=

# Must be the same value as the CONSOLE_KEY variable on the Railway web service.
# It stays on your Mac: the console's local server adds it to requests, the browser never sees it.
CONSOLE_KEY=
