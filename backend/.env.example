# Set these as Railway variables on the web service (and the cron service). Never commit real values.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=${{Postgres.DATABASE_URL}}
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
GHL_PRIVATE_TOKEN=
GHL_LOCATION_ID=hQfWlcg3R4QsKoSZBWAy
INGEST_KEY=
# Content console key: a long random value, at least 32 characters (e.g. `openssl rand -hex 32`). Put the same value in console/.env.local. Blank or shorter = console off.
CONSOLE_KEY=
# Who is calling (rate limits, lockouts, the place lookup). Leave both unset on Railway to start with.
# CLIENT_IP_HEADER: the header the host's proxy fills in with the caller's address. Railway's documentation says its
# edge uses X-Real-IP. That has not been checked on the live server yet: after a deploy, read the "Caller address:"
# line in the web log (README, "After a deploy: check the caller address") and change these two if it says to.
# On another host, name the header its proxy always writes itself, or leave it blank to use NUM_PROXIES below.
CLIENT_IP_HEADER=X-Real-IP
# NUM_PROXIES: only used when that header is missing: how many proxies sit in front of the app, to count
# X-Forwarded-For entries from the right. 0 = ignore X-Forwarded-For and use the connection's own address.
NUM_PROXIES=1
# Where the owner's alert emails go (sign-ups, removals, the daily summary, support tickets and crashes, and one-off
# notices such as a Monday Minute waiting for approval). They are sent through GoHighLevel with the token above, which
# needs the scopes contacts.write, contacts.readonly and conversations/message.write. Blank = no alerts.
OWNER_ALERT_EMAIL=
# Support tickets and crash reports. Set all three on the web service and on the cron service.
# SUPPORT_ENABLED: 0 stops storing reports and crash reports (phones still get a normal answer). Default 1.
SUPPORT_ENABLED=1
# SUPPORT_CRASH_KEEP_DAYS: single crash reports older than this many days are deleted. Tickets and counts stay.
SUPPORT_CRASH_KEEP_DAYS=90
# PUBLIC_URL: this server's public address, like https://api.example.com (no slash at the end). It puts an "Open it"
# link to the admin in the owner's ticket emails. Blank = no link.
PUBLIC_URL=
# Monday Minute timing, in seconds. Leave both unset unless the AI server is slower or faster than expected.
# MONDAY_STEP_BUDGET: how long one cron run of monday_minute may spend on AI work in all (0 = no ceiling). What is
# not finished carries on in the next run, so the other scheduled jobs are never held back longer than this.
MONDAY_STEP_BUDGET=1800
# LOCAL_AI_FAST_TIMEOUT: how long to wait for one short AI answer (screening one comment) before giving up on it.
LOCAL_AI_FAST_TIMEOUT=180
