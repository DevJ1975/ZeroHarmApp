# Copy to .env and fill in. EXPO_PUBLIC_ values ship inside the app, so only public values go here.
EXPO_PUBLIC_API_URL=https://YOUR-SERVICE.up.railway.app
EXPO_PUBLIC_ONESIGNAL_APP_ID=YOUR_ONESIGNAL_APP_ID
# Needed before the App Store build: public pages and the address people write to for help or to have their data deleted.
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
